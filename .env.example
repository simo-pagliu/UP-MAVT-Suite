# Admin password for the admin panel
# Change this to a secure password in production
ADMIN_PASSWORD=admin123

# Email system configuration
# Set to "true" to disable the entire email system (default: "false")
# When disabled, email verification is skipped and users can create case studies
# without providing an email address. All transactional emails are skipped.
# When disabled, all SMTP/OAuth2 environment variables below are ignored.
DISABLE_EMAIL=false

# Email / SMTP configuration
# Required only if DISABLE_EMAIL is "false"
# Set SMTP_HOST to enable email notifications.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=EMAIL_USER
SMTP_PASSWORD=EMAIL_PASSWORD
# Authentication mode for SMTP: "basic" or "oauth2"
EMAIL_AUTH_MODE=basic
# OAuth2 / Microsoft Entra settings (required when EMAIL_AUTH_MODE=oauth2)
OAUTH2_TENANT_ID=
OAUTH2_CLIENT_ID=
# Prefer Docker secret mount via OAUTH2_CLIENT_SECRET_FILE in docker-compose.yml
# OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPE=https://outlook.office365.com/.default
# Optional override; defaults to
# https://login.microsoftonline.com/<OAUTH2_TENANT_ID>/oauth2/v2.0/token
OAUTH2_TOKEN_URL=
# SMTP identity for OAuth2 XOAUTH2. Defaults to SMTP_USER if empty.
OAUTH2_USERNAME=
# Set to "true" to use STARTTLS (recommended), "false" for plain SMTP
SMTP_USE_TLS=true
# Sender address shown in outgoing emails
EMAIL_FROM=EMAIL_USER
# Public base URL used to build links in emails (no trailing slash)
APP_BASE_URL=http://localhost:3000
