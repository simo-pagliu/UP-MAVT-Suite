# Admin password for the admin panel
# Change this to a secure password in production
ADMIN_PASSWORD=admin123

# Backend settings
FLASK_PORT=5000
FLASK_DEBUG=false
MAX_CONTENT_LENGTH_MB=10

# Monte-Carlo iteration limits for the UP-MAVT workflow
MC_ITERATIONS_MIN=100
MC_ITERATIONS_MAX=5000
MC_ITERATIONS_MAX_STEP6=10000
MC_ITERATIONS_DEFAULT=1000

# Worker settings
POLL_INTERVAL=2
PHASE2_SAMPLES=1000
