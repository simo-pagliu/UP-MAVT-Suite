# Shared environment for the Docker Compose deployment.
# These defaults are suitable for a simple local setup without email.

# Public URL of the frontend, used by the backend when generating links.
APP_BASE_URL=http://localhost:3000

# MongoDB settings used by the backend and worker services.
MONGO_URI=mongodb://mongo:27017/elicitation
MONGO_INITDB_DATABASE=elicitation

# Flask runtime mode.
FLASK_ENV=production

# Admin password used by the backend.
ADMIN_PASSWORD=admin123

# Disable email delivery by default for local deployments.
DISABLE_EMAIL=true

# Frontend configuration.
VITE_API_URL=http://localhost:5000/api
VITE_DEBUG_CONSOLE=false

# Optional SMTP/OAuth2 settings used only when DISABLE_EMAIL=false.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true
# EMAIL_AUTH_MODE=basic
# EMAIL_FROM=your-email@example.com
# OAUTH2_TENANT_ID=
# OAUTH2_CLIENT_ID=
# OAUTH2_CLIENT_SECRET=
# OAUTH2_SCOPE=https://outlook.office365.com/.default
# OAUTH2_TOKEN_URL=
# OAUTH2_USERNAME=
