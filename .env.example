# Email / SMTP configuration
# Set SMTP_HOST to enable email notifications (session confirmation,
# inactivity warnings, elicitation completion alerts).
# Leave SMTP_HOST blank to disable email sending entirely.
SMTP_HOST=smtp-mail.outlook.com # e.g., "smtp.gmail.com" for Gmail
SMTP_PORT=587 # e.g., 587 for STARTTLS, 465 for SSL
SMTP_USER=EMAIL_USER
SMTP_PASSWORD=EMAIL_PASSWORD
# Set to "true" to use STARTTLS (recommended), "false" for plain SMTP
SMTP_USE_TLS=true
# Sender address shown in outgoing emails
EMAIL_FROM=EMAIL_USER
# Public base URL used to build links in emails (no trailing slash)
APP_BASE_URL=http://localhost:3000
